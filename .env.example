# Backend API base URL
VITE_API_BASE_URL=http://localhost:3000

# Application Configuration
VITE_APP_TITLE=OmniCanvas

# Feature Flags (defaults only)
# Admin → 系统概览 → 功能开关 is the runtime source of truth.
# These Vite values are used only before /features loads, or if the API is down.
VITE_ENABLE_AGENT=true
# Set to false to hide image generation tools and block generate-image APIs
VITE_ENABLE_IMAGE_GEN=true
# Set to false to hide video generation tools and block generate-video APIs
VITE_ENABLE_VIDEO_GEN=true
# Set to false to hide background removal and block remove-bg APIs
VITE_ENABLE_REMOVE_BG=true

# Google Sign-In Authentication (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
